{
  "name": "upstream-react",
  "version": "0.6.0",
  "description": "Hierarchical reactive stores for React",
  "packageManager": "pnpm@10.18.3",
  "keywords": [
    "upstream",
    "react",
    "state",
    "store",
    "cache",
    "hierarchy"
  ],
  "homepage": "https://github.com/LucasOliveiraaa/Upstream#readme",
  "bugs": {
    "url": "https://github.com/LucasOliveiraaa/Upstream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasOliveiraaa/Upstream.git"
  },
  "license": "MIT",
  "author": "Lucas Oliveira",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunchee",
    "clean": "rimraf ./dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false && tsc -p tsconfig.test.json",
    "test": "jest --runInBand",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bunchee": "^7.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "msw": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  }
}
